// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Key/value store for editable site content (one JSON blob per section).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Visitor feedback & suggestions submitted from the public site.
model Feedback {
  id        String    @id @default(cuid())
  name      String    @default("")
  contact   String    @default("")
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Single-row global visitor counter (key is always "site").
model VisitCounter {
  key       String   @id @default("site")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
